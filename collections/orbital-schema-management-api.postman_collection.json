  "info": {
    "_postman_id": "12e950ec-aa1f-423d-9410-42c186e1752d",
    "name": "Orbital Schema Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Orbital Schema Management API provides endpoints for managing schemas, types, and data source definitions within an Orbital workspace. It allows developers to register, update, and remove Taxi schemas and type definitions that Orbital uses to understand the semantic relationships between data across connected services. Schemas can originate from OpenAPI specs, Protobuf definitions, database schemas, or Taxi projects, and are used by the TaxiQL query engine to automatically discover and orchestrate data fetching across multiple sources.\n\nContact Support:\n Name: Orbital Support",
      "type": "text/plain"
    }
  }
